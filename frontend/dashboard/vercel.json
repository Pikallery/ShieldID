{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/sandbox/(.*)",
      "destination": "https://api.sandbox.co.in/$1"
    },
    {
      "source": "/mobile/(.*)",
      "destination": "/mobile/$1"
    },
    {
      "source": "/mobile",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

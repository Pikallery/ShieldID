# .env.example
# ⚠️ OWNER: Dev 1 - Copy this to .env and fill in your values ⚠️

# ---------- DATABASE ----------
DATABASE_URL=postgresql+asyncpg://shieldid:admin123@db:5432/shieldid

# ---------- REDIS ----------
REDIS_URL=redis://redis:6379/0

# ---------- SECURITY ----------
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-256-BIT-KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- APP ----------
PROJECT_NAME=ShieldID
VERSION=1.0.0
API_V1_PREFIX=/api/v1
MODE=development
ALLOWED_ORIGINS=["*"]

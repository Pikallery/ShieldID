# ─── Application ─────────────────────────────────────────────────────────────
PROJECT_NAME=ShieldID
VERSION=1.0.0
MODE=development                   # development | production

# ─── API ─────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://shieldid:admin123@localhost:5432/shieldid

# ─── Redis Cache ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── File Storage ────────────────────────────────────────────────────────────
# Local path where uploaded documents & selfies are stored
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
# .env.example
# ⚠️ OWNER: Dev 1 - Copy this to .env and fill in your values ⚠️

# ---------- DATABASE ----------
DATABASE_URL=postgresql+asyncpg://shieldid:admin123@db:5432/shieldid

# ---------- REDIS ----------
REDIS_URL=redis://redis:6379/0

# ---------- SECURITY ----------
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-256-BIT-KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- APP ----------
PROJECT_NAME=ShieldID
VERSION=1.0.0
API_V1_PREFIX=/api/v1
MODE=development
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
